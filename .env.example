# Backend always runs in deterministic replay mode in the MVP.
DATA_MODE=replay

# Model-driven orchestrator. Use deterministic to run without an API.
AGENT_PROVIDER=deterministic

# DeepSeek OpenAI-compatible API.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional NVIDIA NIM OpenAI-compatible endpoint for the next iteration.
NIM_BASE_URL=
NIM_API_KEY=
NIM_MODEL=

# Optional live road routing. Keep the real key in .env only.
ROUTING_PROVIDER=replay
ORS_BASE_URL=https://api.openrouteservice.org
ORS_API_KEY=

# Optional temporary address geocoding. Keep the real token in .env only.
MAPBOX_ACCESS_TOKEN=

# Frontend API URL.
VITE_API_BASE=http://127.0.0.1:8000
