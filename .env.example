# Backend always runs in deterministic replay mode in the MVP.
DATA_MODE=replay

# Model-driven orchestrator. Use deterministic to run without an API.
AGENT_PROVIDER=deterministic

# DeepSeek OpenAI-compatible API.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional NVIDIA NIM OpenAI-compatible endpoint for the next iteration.
NIM_BASE_URL=
NIM_API_KEY=
NIM_MODEL=

# Frontend API URL.
VITE_API_BASE=http://127.0.0.1:8000
